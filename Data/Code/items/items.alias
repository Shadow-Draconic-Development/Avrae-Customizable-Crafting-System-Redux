embed
<drac2>


def search_list(query: str, item_list: list[str]) -> list[str]|None:
    """
    Searches for item in list.

    Args:
        query (str): The query being made
        item_list (list): List of items

    Return:
        list[str]|None: If it finds at least one match, it returns the item(s) in a list, otherwise it returns None
    """

    # Finds at least 1 match
    if len(item_results := [item for item in item_list if query.lower() in item.lower()]) > 0:
        return item_results

    # If it finds no matches
    else:
        return None


def multiple_match_determine(search_result: list[str], input_value: str) -> str|bool:
    """
    Detemines if there is an exact match in search results
    
    Args:
        search_result (list[str]): List of search results
        input_value (str): Input value to match

    Returns:
        str|bool: The exact match if found, otherwise False
    """

    for match in search_result:
        if match.lower() == input_value.lower():
            return match

    return False


def produce_output(output_list: list[str], page_num: int = 1, character_limit: int = 200):

    final_list = [""]
    i = 0

    if page_num < 1:
        page_num = 1

    for content_block in output_list:
        if len(final_list[i] + content_block) >= character_limit:

            if len(final_list) == page_num:
                break

            final_list.append("")
            i += 1

        final_list[i] += f"{content_block}\n"

    if len(final_list) < page_num:
        page_num = len(final_list)

    return f"**Page {page_num}**\n" + final_list[page_num - 1]


def main(input_list: list[str]) -> tuple(str, str, str, str):

    error_img = "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System-Redux/main/Data/images/error.png"
    color = "#CF142B"

    if (svar_dict := get_svar("craft_settings")):
        svar_dict = load_json(svar_dict)

    else:
        return "You Have Been Sneak Attacked by an Error", "SVAR settings has not been setup", error_img, color

    
    if len(input_list) == 0:
        page_num = 1

        outer_list = []

        for category in svar_dict["Categories"].keys():

            inner_list = [item_type for item_type in svar_dict["Categories"][category].keys()]

            inner_list.insert(0, f"**{category}:**")
            inner_list[-1] += "\n"

            outer_list.append("\n".join(inner_list))

            character_limit = 75

    else:

        try:
            page_num = int(input_list[0])

            outer_list = []

            for category in svar_dict["Categories"].keys():

                inner_list = [item_type for item_type in svar_dict["Categories"][category].keys()]

                inner_list.insert(0, f"**{category}:**")
                inner_list[-1] += "\n"

                outer_list.append("\n".join(inner_list))

                character_limit = 75

        except:

            if (search_result := search_list(input_list[0], svar_dict["Categories"].keys())):

                if len(search_result) == 1:
                    input_list[0] = search_result[0]

                else:
                    if (match := multiple_match_determine(search_result, input_list[0])):
                        input_list[0] = match

                    else:
                        return "You Have Been Sneak Attacked by an Error", "**Multiple Item Categories Found:**\n" + "\n".join(search_result), error_img, color


            else:
                return "You Have Been Sneak Attacked by an Error", "Item Category Not Found", error_img, color


            if len(input_list) < 2:
                page_num = 1

            else:
                try:
                    page_num = int(input_list[1])

                except:
                    return "You Have Been Sneak Attacked by an Error", "Expected a number for page number", error_img, color

            outer_list = []

            for item_type, item_settings in svar_dict["Categories"][input_list[0]].items():
                inner_list = [
                    f"**Level Req:** {item_settings[0]}",
                    f"**DC:** {item_settings[1]}",
                    f"**Nat1 Penalty:** {item_settings[2]}",
                    f"**Nat20 Bonus:** {item_settings[3]}",
                    f"**Total Successes:** {item_settings[4]}",
                    f"**Total Failures:** {item_settings[5]}",
                    f"**Cooldown (Seconds):** {item_settings[6]}"
                ]

                if len(item_settings) == 8:
                    inner_list.insert(0, f"**Cost Threshold:** {item_type}")
                    inner_list.append(f"**Hex Code:** {item_settings[7]}\n")

                else:
                    inner_list.insert(0, f"**Item Type:** {item_type}")
                    inner_list.append(f"**Crafting Cost:** {item_settings[7]}")
                    inner_list.append(f"**Hex Code:** {item_settings[8]}\n")

                outer_list.append("\n".join(inner_list))

            character_limit = 500

    return "Server Craftable Items", produce_output(outer_list, page_num, character_limit), "https://raw.githubusercontent.com/Shadow-Draconic-Development/Avrae-Customizable-Crafting-System-Redux/main/Data/images/list.png", ""


title, f, thumb, color = main(&ARGS&)
l = "<"


</drac2>
-title "{{title}}"
-f "{{f}}"
-thumb "{{thumb}}"
-color "{{color}}"
-footer "{{ctx.prefix}}craft items {{l}}item category | #> {{l}}#> | 9/5/24 | ShadowsStride"